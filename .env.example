# Copy to .env and adjust. Never commit the real .env.

# --- PostgreSQL ---
POSTGRES_USER=deal
POSTGRES_PASSWORD=change-me
POSTGRES_DB=deal_intelligence
POSTGRES_PORT=5433

# --- API ---
JWT_SECRET=replace-with-a-long-random-string
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
API_PORT=8001

# --- Local LLM (Ollama must be running on the host) ---
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# --- Hindsight memory layer ---
HINDSIGHT_URL=http://localhost:8889
HINDSIGHT_ENABLED=true
HINDSIGHT_PORT=8889
HINDSIGHT_CP_PORT=9999

# --- Demo data ---
SEED_DEMO_DATA=true
SEED_DEMO_PASSWORD=demo-password-123

# --- Frontend ---
WEB_PORT=8080
